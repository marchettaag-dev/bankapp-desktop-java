<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="300.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RegistroController">
   <children>
      <Label alignment="TOP_CENTER" text="Crear Cuenta">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label depthTest="DISABLE" nodeOrientation="LEFT_TO_RIGHT" prefHeight="17.0" prefWidth="408.0" text="Nombre">
         <VBox.margin>
            <Insets left="5.0" />
         </VBox.margin>
      </Label>
      <TextField fx:id="txtNombre" promptText="Juan">
         <VBox.margin>
            <Insets left="5.0" right="5.0" />
         </VBox.margin>
      </TextField>
      <Label layoutX="25.0" layoutY="20.0" prefHeight="17.0" prefWidth="437.0" text="Apellido">
         <VBox.margin>
            <Insets left="5.0" top="5.0" />
         </VBox.margin>
      </Label>
      <TextField fx:id="txtApellido" layoutX="25.0" layoutY="37.0" promptText="Garcia">
         <VBox.margin>
            <Insets left="5.0" />
         </VBox.margin>
      </TextField>
      <Label prefHeight="17.0" prefWidth="406.0" text="Email">
         <VBox.margin>
            <Insets left="5.0" top="5.0" />
         </VBox.margin>
      </Label>
      <TextField fx:id="txtEmail" promptText="juan@gmail.com">
         <VBox.margin>
            <Insets left="5.0" top="5.0" />
         </VBox.margin>
      </TextField>
      <Label prefHeight="17.0" prefWidth="452.0" text="Contraseña">
         <VBox.margin>
            <Insets left="5.0" top="5.0" />
         </VBox.margin>
      </Label>
      <TextField fx:id="txtContraseña">
         <VBox.margin>
            <Insets left="5.0" top="5.0" />
         </VBox.margin>
      </TextField>
      <Button fx:id="btnCrearCuenta" mnemonicParsing="false" onAction="#registrarse" prefHeight="25.0" prefWidth="147.0" text="Registrase">
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <VBox.margin>
            <Insets top="5.0" />
         </VBox.margin>
      </Button>
      <Button fx:id="btnIniciarSesion" mnemonicParsing="false" onAction="#iniciarSesion" prefHeight="24.0" prefWidth="84.0" text="Iniciar Sesion">
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
         <font>
            <Font size="11.0" />
         </font>
      </Button>
   </children>
   <padding>
      <Insets bottom="5.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
