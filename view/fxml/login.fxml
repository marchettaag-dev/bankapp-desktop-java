<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="300" prefWidth="400" spacing="10" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">

    <Label contentDisplay="TOP" style="-fx-padding: 5px;" text="Bienvenido a BankAPP!!" textAlignment="CENTER" textOverrun="CLIP">
      <VBox.margin>
         <Insets top="5.0" />
      </VBox.margin>
      <font>
         <Font size="14.0" />
      </font></Label>
   <Label prefHeight="17.0" prefWidth="389.0" text="Email:" />
   <TextField fx:id="txtEmail" prefHeight="26.0" prefWidth="225.0" promptText="ej: juan@gmail.com">
      <VBox.margin>
         <Insets left="5.0" right="5.0" />
      </VBox.margin>
   </TextField>
   <Label prefHeight="17.0" prefWidth="389.0" text="Contraseña:">
      <VBox.margin>
         <Insets top="10.0" />
      </VBox.margin>
   </Label>
   <PasswordField fx:id="txtContraseña">
      <VBox.margin>
         <Insets left="5.0" right="5.0" />
      </VBox.margin>
   </PasswordField>
   <Button fx:id="btnLogin" mnemonicParsing="false" onAction="#handleLogin" prefHeight="25.0" prefWidth="91.0" text="Iniciar Sesion">
      <VBox.margin>
         <Insets top="10.0" />
      </VBox.margin>
   </Button>
   <Button fx:id="btnRegistro" alignment="BOTTOM_CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#handleRegistro" text="¿No tenés cuenta? Registrate">
      <font>
         <Font size="11.0" />
      </font>
      <VBox.margin>
         <Insets top="40.0" />
      </VBox.margin>
   </Button>
	
</VBox>
